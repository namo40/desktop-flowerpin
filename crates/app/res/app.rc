// 설정 창의 틀. 좌표는 대화 상자 단위(DLU)이고, 모든 탭이 격자 하나를 함께 쓴다.
//   창 안쪽 250 x 229, 탭 쪽 232 x 176
//   A열(이름) x 7 너비 107, B열(고르는 칸) x 118 너비 107, 줄 간격 18
//   이름은 콤보 상자보다 2 내려 적는다(글자 밑선을 맞추려고). 가로선은 준 너비보다 조금 짧게 그려져서 1 더 준다.
// 컨트롤 번호는 src/settings_window.rs의 표와 같아야 한다.
//
// windows.h를 쓰지 않으려고 스타일 값은 숫자로 적는다.
//   0x00210003 = CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP      (콤보 상자)
//   0x2080     = ES_NUMBER | ES_AUTOHSCROLL                       (수를 적는 칸. 테두리와 Tab 멈춤은 기본으로 붙는다)
//   0x50000010 = WS_CHILD | WS_VISIBLE | SS_ETCHEDHORZ            (섹션 가로선)
//   0x4080     = SS_ENDELLIPSIS | SS_NOPREFIX                     (길면 끝을 줄이는 글)
//   0x80       = SS_NOPREFIX
#pragma code_page(65001)

1 24 "app.manifest"

// ---------- 창 뼈대: 250 x 229 ----------
100 DIALOGEX 0, 0, 250, 229
STYLE 0x80C808C0
EXSTYLE 0x00050000
CAPTION "설정 - DesktopFlowerpin"
FONT 9, "맑은 고딕", 400, 0, 0x1
BEGIN
    // 탭 컨트롤을 맨 뒤에 적는다. Tab 키 순서가 "탭 머리 > 탭 쪽 > 기본값으로 > 닫기"로 돈다
    // (탭 쪽은 실행 중에 맨 앞 순서로 끼워 넣는다).
    PUSHBUTTON "기본값으로(&D)", 102, 7, 208, 60, 14
    DEFPUSHBUTTON "닫기", 2, 193, 208, 50, 14
    CONTROL "", 101, "SysTabControl32", 0x54010000, 7, 7, 236, 194
END

// ---------- 일반 ----------
201 DIALOGEX 0, 0, 232, 176
STYLE 0x40000440
EXSTYLE 0x00010000
FONT 9, "맑은 고딕", 400, 0, 0x1
BEGIN
    LTEXT "시작", -1, 7, 7, 14, 8
    CONTROL "", -1, "Static", 0x50000010, 25, 11, 201, 1
    AUTOCHECKBOX "Windows 시작할 때 실행(&W)", 1101, 7, 21, 218, 10
    LTEXT "화면", -1, 7, 44, 14, 8
    CONTROL "", -1, "Static", 0x50000010, 25, 48, 201, 1
    LTEXT "크기(&S):", 1112, 7, 58, 107, 8
    COMBOBOX 1103, 118, 56, 107, 120, 0x00210003
    AUTOCHECKBOX "항상 위(&T)", 1104, 7, 76, 218, 10
END

// ---------- 꽃핀 ----------
202 DIALOGEX 0, 0, 232, 176
STYLE 0x40000440
EXSTYLE 0x00010000
FONT 9, "맑은 고딕", 400, 0, 0x1
BEGIN
    LTEXT "움직임", -1, 7, 7, 21, 8
    CONTROL "", -1, "Static", 0x50000010, 32, 11, 194, 1
    LTEXT "가끔 하는 행동(&A):", 1212, 7, 21, 107, 8
    COMBOBOX 1203, 118, 19, 107, 120, 0x00210003
    LTEXT "꽃핀 더 부르기", -1, 7, 44, 46, 8
    CONTROL "", -1, "Static", 0x50000010, 57, 48, 169, 1
    LTEXT "머무르기(&K):", 1214, 7, 58, 107, 8
    EDITTEXT 1205, 118, 56, 40, 12, 0x2080
    LTEXT "초 (0이면 계속)", 1216, 162, 58, 63, 8
    LTEXT "한 번에 최대(&M):", 1215, 7, 76, 107, 8
    COMBOBOX 1206, 118, 74, 107, 160, 0x00210003
END

// ---------- 방송 ----------
203 DIALOGEX 0, 0, 232, 176
STYLE 0x40000440
EXSTYLE 0x00010000
FONT 9, "맑은 고딕", 400, 0, 0x1
BEGIN
    LTEXT "방송 상태 확인", -1, 7, 7, 46, 8
    CONTROL "", -1, "Static", 0x50000010, 57, 11, 169, 1
    AUTOCHECKBOX "방송 상태 확인 (인터넷 사용)(&L)", 1301, 7, 21, 218, 10
    LTEXT "확인 간격(&I):", 1311, 17, 39, 97, 8
    COMBOBOX 1302, 118, 37, 107, 120, 0x00210003
    LTEXT "방송 시작 안내(&S):", 1312, 17, 57, 97, 8
    COMBOBOX 1303, 118, 55, 107, 120, 0x00210003
    LTEXT "방송 종료 안내(&E):", 1313, 17, 75, 97, 8
    COMBOBOX 1304, 118, 73, 107, 120, 0x00210003
    LTEXT "", 1305, 7, 94, 218, 8, 0x4080
    LTEXT "바로 가기", -1, 7, 116, 30, 8
    CONTROL "", -1, "Static", 0x50000010, 41, 120, 185, 1
    PUSHBUTTON "방송(&1)", 1321, 7, 128, 107, 14
    PUSHBUTTON "유튜브(&2)", 1322, 118, 128, 107, 14
    PUSHBUTTON "팬카페(&3)", 1323, 7, 146, 107, 14
    PUSHBUTTON "방송 시간표(&4)", 1324, 118, 146, 107, 14
END

// ---------- 방해하지 않기 ----------
204 DIALOGEX 0, 0, 232, 176
STYLE 0x40000440
EXSTYLE 0x00010000
FONT 9, "맑은 고딕", 400, 0, 0x1
BEGIN
    LTEXT "숨기기", -1, 7, 7, 21, 8
    CONTROL "", -1, "Static", 0x50000010, 32, 11, 194, 1
    AUTOCHECKBOX "전체화면일 때 숨기기(&F)", 1401, 7, 21, 218, 10
    LTEXT "알림", -1, 7, 44, 14, 8
    CONTROL "", -1, "Static", 0x50000010, 25, 48, 201, 1
    AUTOCHECKBOX "메모 알림을 Windows 알림으로도 띄우기(&N)", 1403, 7, 58, 218, 10
END

// ---------- 정보 ----------
205 DIALOGEX 0, 0, 232, 176
STYLE 0x40000440
EXSTYLE 0x00010000
FONT 9, "맑은 고딕", 400, 0, 0x1
BEGIN
    ICON "", 1501, 7, 7, 20, 20
    LTEXT "DesktopFlowerpin", 1502, 34, 8, 191, 8, 0x80
    LTEXT "", 1503, 34, 18, 191, 8, 0x80
    LTEXT "지금 쓰는 자원", -1, 7, 32, 46, 8
    CONTROL "", -1, "Static", 0x50000010, 57, 36, 169, 1
    LTEXT "메모리:", 1513, 7, 44, 107, 8
    LTEXT "-", 1511, 118, 44, 107, 8, 0x80
    LTEXT "CPU:", 1514, 7, 56, 107, 8
    LTEXT "-", 1512, 118, 56, 107, 8, 0x80
    LTEXT "이 앱은", -1, 7, 75, 23, 8
    CONTROL "", -1, "Static", 0x50000010, 34, 79, 192, 1
    LTEXT "꽃핀 공지에 따른 무료 팬게임입니다. 판매하지 않습니다.", 1531, 7, 87, 218, 8, 0x80
    LTEXT "인터넷은 방송 상태 확인에만 씁니다. 치지직의 비공식 주소를 씁니다.", 1532, 7, 97, 218, 8, 0x4080
    LTEXT "관리자 권한을 쓰지 않고, 메모는 이 PC에만 저장합니다.", 1533, 7, 107, 218, 8, 0x80
    LTEXT "그림은 라이선스가 따로입니다. 다시 배포하거나 고쳐 쓸 수 없습니다.", 1534, 7, 117, 218, 8, 0x4080
    PUSHBUTTON "설정 폴더 열기(&O)", 1521, 7, 155, 107, 14
    PUSHBUTTON "GitHub 페이지 열기(&G)", 1522, 118, 155, 107, 14
END

// ---------- 메모 창: 250 x 229 ----------
//   왼쪽에 메모 목록(x 7 너비 96), 오른쪽에 고른 메모(x 110 너비 133).
//   오른쪽의 이름은 x 110, 고르는 칸은 x 150 너비 93. 여백과 줄 간격은 설정 창과 같다.
//   0x00210100 = LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP                  (목록. 고름 알림과 테두리는 기본으로 붙는다)
//   0x00201044 = ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL       (여러 줄 적는 칸)
//   0x5001000C = WS_CHILD | WS_VISIBLE | WS_TABSTOP | DTS_SHORTDATECENTURYFORMAT  (날짜 고르는 칸)
//   0x50010009 = WS_CHILD | WS_VISIBLE | WS_TABSTOP | DTS_TIMEFORMAT              (시각 고르는 칸)
// 컨트롤 번호는 src/memo_window.rs의 것과 같아야 한다.
300 DIALOGEX 0, 0, 250, 229
STYLE 0x80C808C0
EXSTYLE 0x00050000
CAPTION "메모와 알림 - DesktopFlowerpin"
FONT 9, "맑은 고딕", 400, 0, 0x1
BEGIN
    LTEXT "메모(&M)", 3011, 7, 7, 96, 8
    LISTBOX 3001, 7, 18, 96, 164, 0x00210100
    PUSHBUTTON "새 메모(&N)", 3002, 7, 186, 46, 14
    PUSHBUTTON "지우기(&X)", 3003, 57, 186, 46, 14
    LTEXT "내용(&C)", 3012, 110, 7, 133, 8
    EDITTEXT 3004, 110, 18, 133, 90, 0x00201044
    LTEXT "알림(&R):", 3013, 110, 116, 38, 8
    COMBOBOX 3005, 150, 114, 93, 120, 0x00210003
    LTEXT "날짜(&D):", 3014, 110, 134, 38, 8
    CONTROL "", 3006, "SysDateTimePick32", 0x5001000C, 150, 132, 93, 12
    LTEXT "시각(&T):", 3015, 110, 152, 38, 8
    CONTROL "", 3007, "SysDateTimePick32", 0x50010009, 150, 150, 93, 12
    LTEXT "", 3008, 110, 168, 133, 8, 0x4080
    AUTOCHECKBOX "꽃핀이 들고 있기(&H)", 3009, 110, 188, 133, 10
    LTEXT "메모는 암호화하지 않고 이 PC에만 저장합니다.\n비밀번호 같은 것은 적지 마세요.", 3016, 7, 205, 180, 17, 0x80
    DEFPUSHBUTTON "닫기", 2, 193, 208, 50, 14
END
